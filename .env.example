# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI (for GPT-4o-mini signal classification)
OPENAI_API_KEY=sk-your-openai-key

# Discord Bot (used by both the realtime bot in bot/index.ts and the REST backup in src/lib/ingest-discord.ts)
DISCORD_BOT_TOKEN=your-discord-bot-token

# Classify API secret (protects /api/ingest — the manual trigger)
CLASSIFY_SECRET=your-random-secret

# Cron secret (protects /api/cron/classify — Vercel Cron sends this automatically)
CRON_SECRET=your-random-cron-secret
